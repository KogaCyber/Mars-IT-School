# ---------------------------------------------------------------------------
# Production build — mars, core.marsit.uz/school/
#
# Bu fayl ataylab git'da: `VITE_` prefiksli qiymatlar build vaqtida bundle
# ichiga yoziladi, ya'ni ular baribir ommaviy. Bu yerda sir bo'lmasligi kerak.
# ---------------------------------------------------------------------------

# Sayt domen ildizida emas, /school/ yo'lida turadi.
VITE_BASE_PATH=/school/

# Backend o'sha domenning o'sha prefiksida (nginx `/school/api/` ni gunicorn'ga
# uzatadi). Bir xil manba — CORS umuman ishlamaydi.
VITE_API_BASE_URL=https://core.marsit.uz/school

# Canonical, hreflang, sitemap.xml, llms.txt uchun to'liq manzil.
VITE_SITE_URL=https://core.marsit.uz/school
