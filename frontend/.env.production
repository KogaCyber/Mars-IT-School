# ---------------------------------------------------------------------------
# Production build (Vercel) uchun qiymatlar.
#
# Bu fayl ATAYLAB git'ga qo'shilgan: `VITE_` prefiksli o'zgaruvchilar build
# vaqtida bundle ichiga yoziladi, ya'ni ular baribir ommaviy. Bu yerda hech
# qanday maxfiy qiymat bo'lmasligi kerak.
#
# Vercel → Settings → Environment Variables da xuddi shu nomlar qo'yilsa,
# ular shu fayldan ustun turadi.
# ---------------------------------------------------------------------------

# Backend API — Railway
VITE_API_BASE_URL=https://mars-it-school-production.up.railway.app

# Saytning to'liq manzili — canonical, hreflang, sitemap.xml, llms.txt
VITE_SITE_URL=https://mars-it-school-lemon.vercel.app
