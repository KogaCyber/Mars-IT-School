# ---------------------------------------------------------------------------
# Mars IT School — backend muhit o'zgaruvchilari
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` HECH QACHON git'ga qo'shilmaydi.
# ---------------------------------------------------------------------------

# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me-too

# PRODUCTIONDA ALBATTA False. Bu qiymat True qolsa Django xatolik sahifalarida
# sozlamalarni va maxfiy kalitlarni ko'rsatib qo'yadi.
DEBUG=True
LOG_LEVEL=INFO

# Vergul bilan ajratilgan ro'yxatlar
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# MongoDB ulanish satri.
#   Lokal:  mongodb://localhost:27017/mars_it_school
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mars_it_school?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mars_it_school
MONGODB_NAME=mars_it_school

# Productionda admin panel manzilini o'zgartiring (masalan: mars-panel-7fa2/)
ADMIN_URL=admin/

# Xizmat roli — qaysi URL'lar shu jarayonda ochiladi:
#   all   — API + admin bitta portda (standart)
#   api   — faqat /api/v1/ va /health/
#   admin — faqat admin panel va /health/
# Admin panelni alohida portda ochish uchun ikkita jarayon ishga tushiriladi:
#   SERVICE_ROLE=api   python manage.py runserver 8000
#   SERVICE_ROLE=admin python manage.py runserver 8001
SERVICE_ROLE=all

# JWT muddatlari
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Brute-force himoyasi
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mars IT School <no-reply@marsit.uz>
LEAD_NOTIFY_EMAILS=

# Telegram xabarnomasi (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis kesh (ixtiyoriy, lekin PRODUCTIONDA TAVSIYA ETILADI).
# Redis'siz har bir gunicorn worker'i o'z hisobini yuritadi, shuning uchun
# so'rov cheklovlari (throttling) va login bloklash amalda 3 baravar bo'shashadi.
REDIS_URL=

# Ilova oldida turgan ishonchli proksilar soni.
#   1 — Railway / Vercel / Nginx orqasida (standart)
#   0 — to'g'ridan-to'g'ri, proksisiz
# Bu qiymat noto'g'ri bo'lsa IP bo'yicha cheklovlarni aylanib o'tish mumkin.
NUM_PROXIES=1

# Yuklangan rasm/fayllar saqlanadigan papka.
# Railway konteyner diski vaqtinchalik — har deploy'da fayllar o'chadi.
# Railway → Volumes bo'limidan volume qo'shib, shu yerga mount path yozing.
MEDIA_ROOT=

# Xatoliklar haqida xabar keladigan manzillar
ADMIN_EMAILS=

# HTTPS'ga majburiy yo'naltirish (production'da True bo'lib qolsin)
SECURE_SSL_REDIRECT=True


# ---------------------------------------------------------------------------
# PRODUCTION uchun namuna (Railway → Variables)
# ---------------------------------------------------------------------------
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DEBUG=False
#   DJANGO_SECRET_KEY=<64 belgili tasodifiy kalit>
#   JWT_SIGNING_KEY=<boshqa tasodifiy kalit>
#   ALLOWED_HOSTS=api.marsitschool.uz,mars-backend.up.railway.app
#   CORS_ALLOWED_ORIGINS=https://marsitschool.uz,https://www.marsitschool.uz
#   CSRF_TRUSTED_ORIGINS=https://marsitschool.uz,https://api.marsitschool.uz
#   ADMIN_URL=mars-panel-7fa2/
#   MONGODB_URI=mongodb+srv://...
#   FRONTEND_URL=https://marsitschool.uz
