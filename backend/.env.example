# ---------------------------------------------------------------------------
# Mars IT School — backend muhit o'zgaruvchilari (NAMUNA)
#
# Bu faylni `.env` ga nusxalab, qiymatlarni to'ldiring:
#     cp .env.example .env
#
# `.env` git'ga TUSHMAYDI (`.gitignore`). Bu faylga esa hech qachon haqiqiy
# sir yozmang — u repozitoriyda saqlanadi va uni hamma ko'radi.
# ---------------------------------------------------------------------------

# === MAJBURIY =============================================================

# Django imzo kaliti. Yangi qiymat yaratish:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# Bu kalit JWT imzolash, sessiya va CSRF tokenlari uchun ishlatiladi —
# u sizib chiqsa, hujumchi istalgan foydalanuvchi nomidan token yasay oladi.
DJANGO_SECRET_KEY=

# Sayt qaysi domenlarda ishlaydi (vergul bilan). Bo'sh qoldirilsa
# production ishga tushmaydi.
ALLOWED_HOSTS=api.marsitschool.uz

# Frontend qaysi domendan API'ga murojaat qiladi.
CORS_ALLOWED_ORIGINS=https://marsitschool.uz
CSRF_TRUSTED_ORIGINS=https://marsitschool.uz

# MongoDB ulanish satri.
#   lokal:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=mars_it_school


# === XAVFSIZLIK ===========================================================

# Admin panel manzili. Standart `admin/` da QOLDIRMANG — bu botlar birinchi
# bo'lib urinadigan manzil. Masalan: `boshqaruv-7fq2/`.
ADMIN_URL=admin/

# Admin panelga kirish ruxsat etilgan IP manzillar yoki tarmoqlar
# (vergul bilan). Bo'sh bo'lsa — cheklov yo'q.
# To'ldirilsa, parol o'g'irlangan taqdirda ham begona IP admin paneliga
# umuman yeta olmaydi. Masalan: 84.54.72.10,84.54.73.0/24
ADMIN_ALLOWED_IPS=

# Ilova oldida turgan ishonchli proksilar soni.
#   Railway / Vercel ortida — 1
#   to'g'ridan-to'g'ri (proksisiz) — 0
# Noto'g'ri qiymat X-Forwarded-For'ni soxtalashtirib cheklovlarni aylanib
# o'tishga imkon beradi, shuning uchun aniq ko'rsating.
NUM_PROXIES=1

# Qaysi URL'lar ochilishi: api | admin | all
# Admin panelni ommaviy API'dan alohida jarayonga ajratish uchun.
SERVICE_ROLE=all

# Login urinishlari cheklovi (django-axes).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# JWT muddatlari.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Alohida imzo kaliti (bo'sh bo'lsa DJANGO_SECRET_KEY ishlatiladi).
JWT_SIGNING_KEY=

# Saytda ro'yxatdan o'tish sahifasi yo'q — bu manzil ochiq qolsa faqat spam
# hisob yaratish uchun ishlatiladi. O'quvchi kabineti qo'shilgandagina yoqing.
PUBLIC_REGISTRATION_ENABLED=False

# HTTPS. Lokalda `False` qilish mumkin.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000


# === FAYLLAR ==============================================================

# Sayt rasmlari. Railway'da konteyner diski har deploy'da tozalanadi —
# doimiy Volume ko'rsating.
MEDIA_ROOT=/data/media

# Nomzodlar rezyumesi — SHAXSIY ma'lumot. Bu papka MEDIA_ROOT ICHIDA
# BO'LMASLIGI SHART: aks holda fayllar WhiteNoise orqali ommaga ochiq
# bo'lib qoladi (ishga tushishda tekshiriladi).
PRIVATE_MEDIA_ROOT=/data/private-media


# === IXTIYORIY ============================================================

# Kesh va throttling hisoblari barcha worker'lar uchun umumiy bo'lishi uchun.
REDIS_URL=

# Ariza kelganda xabar yuborish.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mars IT School <no-reply@marsit.uz>
LEAD_NOTIFY_EMAILS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ariza yuborish cheklovi. O'zbekistonda CGNAT keng tarqalgan (bitta IP
# ortida yuzlab odam) — juda qattiq limit haqiqiy mijozni bloklab qo'yadi.
LEAD_THROTTLE_RATE=40/hour

# Ochiq API javoblari shuncha soniya keshlanadi (0 — keshlash o'chadi).
PUBLIC_CACHE_SECONDS=60

LOG_LEVEL=INFO
ADMIN_EMAILS=
