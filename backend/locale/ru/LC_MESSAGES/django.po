msgid "Saytning bosh sahifasida ko‘rinadigan bloklar."
msgstr "Блоки, которые видны на главной странице сайта."

#: apps/core/admin_site.py:34
msgid ""
"«Nega aynan MARS IT School» — raqamlangan kartochkalar («Biz haqimizda» "
"sahifasida ham ko‘rinadi)"
msgstr "«Почему выбирают MARS IT School» — нумерованные карточки (также видны на странице «О нас»)"

#: apps/core/admin_site.py:36
msgid "Raqam (01…06), sarlavha, tavsif, rasm, tartib, chop etish"
msgstr "Номер (01…06), заголовок, описание, изображение, порядок, публикация"

#: apps/core/admin_site.py:40
