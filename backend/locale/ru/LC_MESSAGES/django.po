#: apps/branches/services.py:217
#, python-format
msgid ""
"Xaritadagi nishon ko'chirildi — koordinata %(source)s havolasidan olindi: "
"%(lat)s, %(lon)s."
msgstr ""
"Метка на карте перемещена — координаты взяты из ссылки %(source)s: %(lat)s, "
"%(lon)s."

#: apps/branches/services.py:232
#, python-format
msgid ""
"Koordinata manzil bo'yicha taxminan topildi: %(lat)s, %(lon)s — «%(place)s». "
"Xaritada tekshiring! Noto'g'ri bo'lsa, Yandex yoki Google havolasini qo'ying "
"— havoladan olingan koordinata aniq bo'ladi."
msgstr ""
"Координаты найдены приблизительно по адресу: %(lat)s, %(lon)s — «%(place)s». "
"Проверьте на карте! Если неверно — вставьте ссылку Yandex или Google: "
"координаты из ссылки точные."

#: apps/branches/services.py:239
msgid ""
"Koordinata topilmadi — filial xaritada ko'rinmaydi. Yandex yoki Google "
"havolasini qo'ying, yoki kenglik/uzunlikni qo'lda kiriting."
msgstr ""
"Координаты не найдены — филиал не показан на карте. Вставьте ссылку Yandex "
"или Google либо введите широту/долготу вручную."

#: apps/branches/services.py:244
msgid ""
"Manzil o'zgardi, lekin koordinata topilmadi — xaritadagi nishon eski joyida "
"qoldi. Xarita havolasini yangilang yoki kenglik/uzunlikni qo'lda to'g'rilang."
msgstr ""
"Адрес изменился, но координаты не найдены — метка осталась на прежнем месте. "
"Обновите ссылку на карту или исправьте широту/долготу вручную."

#: apps/core/admin_site.py:28 apps/core/sections.py:25 apps/leads/models.py:18
msgid "Bosh sahifa"
msgstr "Главная"

#: apps/core/admin_site.py:30
msgid "Saytning bosh sahifasi — bloklar saytdagi tartibda."
msgstr "Главная страница сайта — блоки в том же порядке, что и на сайте."

#: apps/core/admin_site.py:34
msgid "Sahifa bo‘limlari: hero, sarlavhalar, matnlar va rasmlar"
msgstr "Блоки страницы: hero, заголовки, тексты и изображения"

#: apps/core/admin_site.py:35
msgid ""
"Hero (sarlavha, matn, tugmalar, astronavt rasmi), SPACE bloki, yangiliklar "
"va o‘qituvchilar sarlavhalari, fikrlar va F.A.Q."
msgstr ""
"Hero (заголовок, текст, кнопки, изображение астронавта), блок SPACE, "
"заголовки новостей и преподавателей, отзывы и F.A.Q."

#: apps/core/admin_site.py:40
msgid "«Nega aynan MARS IT School» — raqamlangan kartochkalar"
msgstr "«Почему именно MARS IT School» — нумерованные карточки"

#: apps/core/admin_site.py:41
msgid "Raqam (01…06), sarlavha, tavsif, rasm, tartib, chop etish"
msgstr "Номер (01…06), заголовок, описание, изображение, порядок, публикация"

#: apps/core/admin_site.py:45
msgid "«Ota-onalar nima deydi» — video kartochkalar karuseli"
msgstr "«Что говорят родители» — карусель видеокарточек"

#: apps/core/admin_site.py:46
msgid "Ism, kimligi (ona/ota), surat, video havolasi, matn, tartib"
msgstr "Имя, кем приходится (мама/папа), фото, ссылка на видео, текст, порядок"

#: apps/core/admin_site.py:50
msgid "«Ko‘p beriladigan savollar» — akkordeon"
msgstr "«Частые вопросы» — аккордеон"

#: apps/core/admin_site.py:51
msgid "Savol, javob, tartib, chop etish"
msgstr "Вопрос, ответ, порядок, публикация"

#: apps/core/admin_site.py:55
msgid "«Maktabda nima bo‘lyapti» — oxirgi yangiliklar lentasi"
msgstr "«Что происходит в школе» — лента последних новостей"

#: apps/core/admin_site.py:56
msgid "Bu yerga «Yangiliklar» sahifasidagi yozuvlar tushadi"
msgstr "Сюда попадают записи со страницы «Новости»"

#: apps/core/admin_site.py:60
msgid "«IT’da ishlaydigan o‘qituvchilar» — karusel"
msgstr "«Преподаватели, которые работают в IT» — карусель"

#: apps/core/admin_site.py:61
msgid "Bu yerga «Biz haqimizda» sahifasidagi o‘qituvchilar tushadi"
msgstr "Сюда попадают преподаватели со страницы «О нас»"

#: apps/core/admin_site.py:67 apps/core/sections.py:26
msgid "Biz haqimizda"
msgstr "О нас"

#: apps/core/admin_site.py:69
msgid "«O нас» sahifasi — bloklar saytdagi tartibda."
msgstr "Страница «О нас» — блоки в том же порядке, что и на сайте."

#: apps/core/admin_site.py:73
msgid "Sahifa bo‘limlari: sarlavhalar, matnlar va rasmlar"
msgstr "Блоки страницы: заголовки, тексты и изображения"

#: apps/core/admin_site.py:74
msgid ""
"Hero, «Nega bu muhim», ko‘nikmalar, Demo Day, «Oddiy kurslar emas», "
"asoschilar va o‘qituvchilar bloklarining matni"
msgstr ""
"Тексты блоков: hero, «Почему это важно», навыки, Demo Day, «Не просто "
"курсы», основатели и преподаватели"

#: apps/core/admin_site.py:79
msgid "«Nima uchun bu kelajak uchun muhim» — kartochkalar"
msgstr "«Почему это важно для будущего» — карточки"

#: apps/core/admin_site.py:80 apps/core/admin_site.py:85
msgid "Sarlavha, tavsif, ikonka, tartib"
msgstr "Заголовок, описание, иконка, порядок"

#: apps/core/admin_site.py:84
msgid "«Bola qanday ko‘nikmalarni egallaydi» — kartochkalar"
msgstr "«Какие навыки развивает ребёнок» — карточки"

#: apps/core/admin_site.py:89
msgid "«Demo Day» raqamlari"
msgstr "Цифры блока «Demo Day»"

#: apps/core/admin_site.py:90
msgid "Raqam/yorliq, izoh, ikonka, tartib"
msgstr "Значение, подпись, иконка, порядок"

#: apps/core/admin_site.py:94
msgid "Statistika chizig‘i (o‘quvchilar soni, yillar…)"
msgstr "Строка статистики (число учеников, годы…)"

#: apps/core/admin_site.py:95
msgid "Qiymat, izoh, tartib"
msgstr "Значение, подпись, порядок"

#: apps/core/admin_site.py:99
msgid "«MARS IT — bu oddiy kurslar emas» ro‘yxati"
msgstr "Список блока «MARS IT — это не просто курсы»"

#: apps/core/admin_site.py:100
msgid "Ro‘yxat bandlari, tartib. Yonidagi video — «Sayt sozlamalari»da"
msgstr "Пункты списка, порядок. Видео рядом — в «Настройках сайта»"

#: apps/core/admin_site.py:104
msgid "«Maktab ortida kim turadi» — asoschilar lentasi"
msgstr "«Кто стоит за школой» — лента основателей"

#: apps/core/admin_site.py:105
msgid "Ism, lavozim, surat, izoh, tartib"
msgstr "Имя, должность, фото, описание, порядок"

#: apps/core/admin_site.py:109
msgid "«O‘qituvchilar» — kartochkalar karuseli"
msgstr "«Преподаватели» — карусель карточек"

#: apps/core/admin_site.py:110
msgid "Ism, lavozim, surat, tajriba, texnologiyalar, tartib"
msgstr "Имя, должность, фото, опыт, технологии, порядок"

#: apps/core/admin_site.py:114
msgid "O‘qituvchi kartochkasidagi texnologiya yorliqlari"
msgstr "Теги технологий в карточке преподавателя"

#: apps/core/admin_site.py:115
msgid "Texnologiya nomi (Python, Figma…) — o‘qituvchiga biriktiriladi"
msgstr "Название технологии (Python, Figma…) — привязывается к преподавателю"

#: apps/core/admin_site.py:121
msgid "Kurslar (ro‘yxat sahifasi)"
msgstr "Курсы (страница со списком)"

#: apps/core/admin_site.py:123
msgid "«Kurslar» sahifasi: hero, yo‘nalish kartochkalari va banner."
msgstr "Страница «Курсы»: hero, карточки направлений и баннер."

#: apps/core/admin_site.py:127
msgid "Sahifa bo‘limlari: hero, «Yo‘nalishlar» kartochkalari, «Tez orada»"
msgstr "Блоки страницы: hero, карточки «Направления», «Скоро»"

#: apps/core/admin_site.py:128
msgid ""
"Sarlavhalar, matnlar, kartochka rasmlari, yosh, texnologiyalar va havolalar"
msgstr "Заголовки, тексты, изображения карточек, возраст, технологии и ссылки"

#: apps/core/admin_site.py:132
msgid "Yo‘nalish yozuvlari (kurs sahifalari uchun ma’lumotnoma)"
msgstr "Записи направлений (справочник для страниц курсов)"

#: apps/core/admin_site.py:133
msgid "Nom, tavsif, rasm, tartib, chop etish"
msgstr "Название, описание, изображение, порядок, публикация"

#: apps/core/admin_site.py:137
msgid "Kurs yozuvi: narx, davomiylik va sahifa pastidagi savol-javoblar"
msgstr "Запись курса: цена, длительность и вопросы-ответы внизу страницы"

#: apps/core/admin_site.py:138
msgid ""
"Nom, yo‘nalish, yosh, narx, davomiylik, tavsif, rasm; ichida — imkoniyatlar, "
"bosqichlar va savol-javoblar"
msgstr ""
"Название, направление, возраст, цена, длительность, описание, изображение; "
"внутри — возможности, этапы обучения и вопросы-ответы"

#: apps/core/admin_site.py:145 apps/core/sections.py:28
msgid "Kurs — IT Kids"
msgstr "Курс — IT Kids"

#: apps/core/admin_site.py:147
msgid ""
"«IT Kids» sahifasi: hero, ko‘rsatkichlar, mavzular, bosqichlar, galereya."
msgstr "Страница «IT Kids»: hero, показатели, темы, этапы, галерея."

#: apps/core/admin_site.py:151 apps/core/admin_site.py:171
msgid "Sahifa bo‘limlari — barcha matn va rasmlar"
msgstr "Блоки страницы — все тексты и изображения"

#: apps/core/admin_site.py:152
msgid ""
"Hero (sarlavha, rasm, tugmalar), ko‘rsatkichlar tasmasi, «Kurs haqida» "
"mavzulari, o‘qish bosqichlari va galereya"
msgstr ""
"Hero (заголовок, изображение, кнопки), лента показателей, темы блока «О "
"курсе», этапы обучения и галерея"

#: apps/core/admin_site.py:157
msgid "Sahifa pastidagi savol-javoblar — «IT Kids» kursi yozuvida"
msgstr "Вопросы-ответы внизу страницы — в записи курса «IT Kids»"

#: apps/core/admin_site.py:158
msgid "Kursni oching va «Savol-javoblar» blokini to‘ldiring"
msgstr "Откройте курс и заполните блок «Вопросы-ответы»"

#: apps/core/admin_site.py:164 apps/core/sections.py:29
msgid "Kurs — IT dasturlash"
msgstr "Курс — IT Разработка"

#: apps/core/admin_site.py:166
msgid ""
"«IT-dasturlash» sahifasi: hero, ko‘rsatkichlar, mavzular, bosqichlar, "
"galereya."
msgstr "Страница «IT-разработка»: hero, показатели, темы, этапы, галерея."

#: apps/core/admin_site.py:172
msgid ""
"Hero, ko‘rsatkichlar tasmasi, «Kurs haqida» mavzulari, o‘qish bosqichlari va "
"galereya"
msgstr ""
"Hero, лента показателей, темы блока «О курсе», этапы обучения и галерея"

#: apps/core/admin_site.py:179 apps/core/sections.py:30
msgid "SPACE platformasi"
msgstr "Платформа SPACE"

#: apps/core/admin_site.py:181
msgid "SPACE ilovasi haqidagi sahifa."
